{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "firewatch17",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "dashboard": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "moderator"
    },
    "redis": true
  },
  "menu": {
    "items": [
      {
        "label": "Open Firewatch queue",
        "description": "Open the existing Firewatch mod queue for this subreddit.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/open-board"
      },
      {
        "label": "Firewatch settings",
        "description": "Set watched words, domains, review scores, reminders, and available mod actions.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/configure"
      },
      {
        "label": "Create Firewatch demo post",
        "description": "Create a demo post with reports and comments so mods can test the workflow.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-demo-incident"
      },
      {
        "label": "Send to Firewatch",
        "description": "Send this post to the Firewatch mod queue.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/escalate-post"
      }
    ]
  },
  "forms": {
    "firewatchConfig": "/internal/form/config-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAutomoderatorFilterComment": "/internal/triggers/on-automod-filter-comment",
    "onAutomoderatorFilterPost": "/internal/triggers/on-automod-filter-post",
    "onCommentCreate": "/internal/triggers/on-comment-create",
    "onCommentDelete": "/internal/triggers/on-comment-delete",
    "onCommentReport": "/internal/triggers/on-comment-report",
    "onModAction": "/internal/triggers/on-mod-action",
    "onPostCreate": "/internal/triggers/on-post-create",
    "onPostDelete": "/internal/triggers/on-post-delete",
    "onPostReport": "/internal/triggers/on-post-report",
    "onPostUpdate": "/internal/triggers/on-post-update"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "firewatch17_dev"
  }
}
